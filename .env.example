# Required for real runs (not for --demo).
ANTHROPIC_API_KEY=

# Required if the server listens beyond localhost (Docker does).
AGENTWS_TOKEN=

# Optional overrides (defaults shown).
AGENTWS_MODEL=claude-opus-5-5
AGENTWS_EFFORT=high
AGENTWS_APPROVAL=safe
AGENTWS_BUDGET=2.00
AGENTWS_COMPACT_AT=150000
AGENTWS_MAX_ITERATIONS=60
